{{ define "content" }}
<div class="widget">
	<h2 class="widget-header">Choose a time control</h2>

	<div class="slider-wrap">
		<input id="slider" class="slider" type="range" min="0" max="8" value="3" autofocus />
	</div>
	<div id="sliderDemo">Bullet</div>

	<div class="widget-buttons">
		<button class="widget-back" onclick="window.history.back()">Back</button>
		<button id="joinMatchmaking" class="widget-next">Play</button>
	</div>
</div>

<dialog id="matchmaking" class="matchmaking">
	<h2 class="dialog-header">Finding match...</h2>

	<h2 id="gameMode" class="dialog-header"></h2>

	<p id="playersNumber">Players in queue: ?</p>
	<p id="hintBox"></p>
	<p id="countUpTimer">00:00</p>

	<p id="ping">Latency: ? ms</p>

	<div class="dialog-buttons">
		<button id="dialogClose">Leave</button>
	</div>
	</div>
</dialog>

<div class="animated-chessboard"></div>
{{ end }}