{{ define "form" }}
<form id="form" class="flex">
	{{ if .Data.hasUsernameField }}
		<div class="form-field">
			<p class="form-field-label">Username</p>
			<input
				id="usernameInput"
				type="text"
				name="username"
				autocomplete="off"
				placeholder="MagnusCarlsen"
			/>
			<div class="form-error" id="formUsernameError"></div>
		</div>
	{{ end }}

	<div class="form-field">
		<p class="form-field-label">Email</p>
		<input
			id="emailInput"
			type="email"
			name="email"
			autocomplete="off"
			placeholder="magnus@carlsen.com"
		/>
		<div class="form-error" id="formEmailError"></div>
	</div>

	<div class="form-field">
		<p class="form-field-label">Password</p>
		<div class="form-field-password">
			<input
				id="passwordInput"
				type="password"
				name="password"
				autocomplete="off"
				placeholder="**********"
			/>
			<img id="passwordToggle" src="/assets/images/show.svg" height="30" width="30">
		</div>
		<div class="form-error" id="formPasswordError"></div>
	</div>

	<div id="serverResponse"></div>
	<button id="submit" type="submit">Confirm via email</button>
</form>
{{ end }}