<!--{
	"title": "Play"
}-->

{{ define "content" }}
<div class="widget">
	<h2 class="widget-header">Choose your opponent</h2>

	<ul class="widget-frame">
		{{ if eq .Player.Name "Guest" }}
			<li><button autofocus class="disabled" onclick="window.alert('Authorization is needed to play with other people.')">Human</button></li>
		{{ else }}
			<li><button autofocus onclick="window.location.href='/human'">Human</button></li>
		{{ end }}
		<li><button onclick="window.location.href='/engine'">Engine</button></li>
	</ul>

	<div class="widget-buttons">
		<button class="widget-back" onclick="window.history.back()">Back</button>
	</div>
</div>

<div class="animated-chessboard"></div>
{{ end }}