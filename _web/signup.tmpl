	"script": "signup.js"
}-->

{{ define "content" }}
<form id="form" class="widget">
	<h2 class="widget-header">Create a new account</h2>

	<div class="form-field">
		<p class="form-field-label">Username</p>
		<input
			id="usernameInput"
			type="text"
			name="username"
			autocomplete="off"
			placeholder="MagnusCarlsen"
		/>
		<div class="form-error" id="formUsernameError"></div>
	</div>

	<div class="form-field">
		<a class="form-field-label" href="/faq">Email</a>
		<input
			id="emailInput"
			type="email"
			name="email"
			autocomplete="off"
			placeholder="magnus@carlsen.com"
		/>
		<div class="form-error" id="formEmailError"></div>
	</div>

	<div class="form-field flex">
		<p class="form-field-label">Password</p>
		<div class="form-field-password-wrap">
			<input
				id="passwordInput"
				type="password"
				name="password"
				autocomplete="off"
				placeholder="**********"
			/>
			<button id="formPasswordToggle"></button>
		</div>
		<div class="form-error" id="formPasswordError"></div>
    </div>

	<div id="serverResponse"></div>

	<div class="widget-buttons">
		<button autofocus class="widget-back" onclick="window.history.back()">Back</button>
		<button id="confirm" class="widget-next">Confirm</button>
	</div>

	<div class="form-footer">
		Already have an account? <a href="/signin">Sign in</a>.
	</div>
</form>

<dialog id="formConfirmation">
	<h2 class="dialog-header">Warning</h2>
	<p>Hello</p>
	<p>Hello</p>
	<div class="dialog-buttons">
		<button id="dialogClose">Close</button>
		<button id="dialogOK">OK</button>
	</div>
</dialog>

<div class="animated-chessboard"></div>
{{ end }}
