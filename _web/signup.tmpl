{{ define "content" }}

{{ template "form" .}}

<button id="submit" commandfor="confirmDialog" command="show-modal" class="form-confirm">Confirm via email</button>

<dialog id="confirmDialog" class="dialog">
	<p>The verification link will be send to your email</p>

	<div class="dialog-buttons">
		<button id="formConfirm">Continue</button>
		<button commandfor="confirmDialog" command="close">Close</button>
	</div>
</dialog>

<small>Already have an account? <a href="/signin">Sign in</a></small>
{{ end }}
