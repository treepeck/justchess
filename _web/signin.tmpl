	"title": "Sign in",
	"style": "form.css",
	"script": "signin.js"
}-->

{{ define "content" }}
<form id="form" class="widget">
	<h2 class="widget-header">Sign in to your account</h2>

	<div class="form-field">
		<p class="form-field-label">Email</p>
		<input
			id="emailInput"
			type="email"
			name="email"
			autocomplete="off"
			placeholder="magnus@carlsen.com"
		/>
		<div class="form-error" id="formEmailError"></div>
	</div>

	<div class="form-field flex">
		<p class="form-field-label">Password</p>
		<div class="form-field-password-wrap">
			<input
				id="passwordInput"
				type="password"
				name="password"
				autocomplete="off"
				placeholder="**********"
			/>
			<button id="formPasswordToggle"></button>
		</div>
		<div class="form-error" id="formPasswordError"></div>
    </div>

	<div id="serverResponse"></div>

	<div class="widget-buttons">
		<button autofocus class="widget-back" onclick="window.history.back()">Back</button>
		<button id="confirm" class="widget-next">Confirm</button>
	</div>

	<div class="form-footer">
		Doesn't have an account? <a href="/signup">Sign up</a>.
	</div>
</form>

<div class="animated-chessboard"></div>
{{ end }}
