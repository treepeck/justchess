<!--{
	"title": "Home"
}-->

{{ define "content" }}
<div class="menu">
	<h2 class="menu-header">
		{{ if eq .Player.Name "Guest" }}
			Greetings!
		{{ else }}
			Welcome back, {{ .Player.Name }}!
		{{ end }}
	</h2>

	<ul class="menu-frame">
		<li><button autofocus onclick="window.location.href='/play'">Play Chess</button></li>
		{{ if eq .Player.Name "Guest" }}
			<li><button onclick="window.location.href='/signup'">Authorize</button></li>
		{{ else }}
			<li><button onclick="window.location.href='/player/{{ .Player.Id }}'">Profile</button></li>
		{{ end }}
		<li><button onclick="window.location.href='/updates'">Updates</button></li>
		<li><button onclick="window.location.href='/leaderboard'">Leaderboard</button></li>
		<li><button onclick="window.location.href='/faq'">General information</button></li>
	</ul>
</div>

<div class="animated-chessboard"></div>
{{ end }}