	"title": "Home",
	"style": "home.css",
	"layouts": ["_web/layouts/engine.tmpl"],
	"script": "home.js"
}-->

{{ define "content" }}
<h1 class="content-header">Welcome back, {{ .Player.Name }}!</h1>

<div class="home-panels">
	<div class="updates-panel">
		<div class="panel-header">Updates</div>
		<div class="panel-content">
			<div class="panel-content-row">
				<div class="update-date">
				</div>
				<div class="update-version">
				</div>
				<div class="update-describtion">
				</div>
			</div>
		</div>
	</div>
	<div class="play-panel">
		<div class="panel-header">Play Chess</div>
		<div class="panel-content">
		</div>
	</div>
</div>

<button>Play Chess</button>

<aside id="playSidebar" class="wrap">
	<ul class="">
		<li></li>
		<li></li>
		<li></li>
		<li></li>
	</ul>
</aside>

<dialog id="ratedConfig" class="wrap">
	<h2 class="dialog-header">Choose a time control</h2>
	<div class="rated-grid">
		<button id="control0">1m</button>
		<button id="control1">2m+1s</button>
		<button id="control2">3m</button>
		<button id="control3">3m+2s</button>
		<button id="control4" autofocus>5m</button>
		<button id="control5">5m+2s</button>
		<button id="control6">10m</button>
		<button id="control7">10m+10s</button>
		<button id="control8">15m+10s</button>
	</div>
	<div class="dialog-buttons">
		<button commandfor="ratedConfig" command="close">Close</button>
	</div>
</dialog>

{{ template "engine" . }}

<div class="floating-chessboard"></div>
{{ end }}