{{ define "content" }}
<div class="widget">
	<h2 class="widget-header">Choose game difficulty</h2>

	<div class="slider-wrap">
		<input id="slider" class="slider" type="range" min="1" max="5" value="2" autofocus/>
	</div>
	<div id="sliderDemo">Bullet</div>

	<div class="widget-buttons">
		<button class="widget-back" onclick="window.history.back()">Back</button>
		<button class="widget-next" onclick="window.location.href='/game'">Play</button>
	</div>
</div>

<div class="animated-chessboard"></div>
{{ end }}